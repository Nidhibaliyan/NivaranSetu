# =============================================================================
# NivaranSetu Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Create a local copy named '.env':
#      PowerShell: Copy-Item .env.example .env
#      Bash/CMD:   cp .env.example .env
# 2. Obtain your free Gemini API key from Google AI Studio:
#      https://aistudio.google.com/app/apikey
# 3. Paste your key into GEMINI_API_KEY below (without quotes or with quotes).
# 4. Never commit your '.env' file to version control (.gitignore excludes it).
# =============================================================================

# Google Gemini API Key (Required for live AI chat, audio transcription & live voice)
GEMINI_API_KEY="your-gemini-api-key-here"

# Server Port (Default: 3000)
PORT=3000

# Base URL of the application
APP_URL="http://localhost:3000"
